{
  "id": "cursor",
  "displayName": "Cursor",
  "sharedConfig": true,
  "surfaces": ["editor", "cli"],
  "pluginFormat": "cursor-plugin",
  "scopes": {
    "global": {
      "root": { "homeRelative": [".cursor"] },
      "components": [
        { "id": "plugin-manifest", "source": "adapters/cursor/global/plugin.json", "destination": "plugins/local/agent-ecosystem/.cursor-plugin/plugin.json", "transform": "plugin-manifest" },
        { "id": "rule", "source": "src/global/instructions", "destination": "plugins/local/agent-ecosystem/rules/portable-instructions.mdc", "transform": "cursor-rule" },
        { "id": "skills", "source": "src/global/skills", "destination": "plugins/local/agent-ecosystem/skills", "transform": "skill-name" },
        { "id": "agents", "source": "src/global/agents", "destination": "plugins/local/agent-ecosystem/agents", "transform": "copy" },
        { "id": "commands", "source": "src/global/commands", "destination": "plugins/local/agent-ecosystem/commands", "transform": "copy" },
        { "id": "templates", "source": "src/global/templates", "destination": "plugins/local/agent-ecosystem/templates", "transform": "copy" }
      ]
    },
    "local": {
      "root": { "projectRelative": ".cursor" },
      "components": [
        { "id": "plugin-manifest", "source": "adapters/cursor/local/plugin.json", "destination": "plugins/agent-ecosystem/.cursor-plugin/plugin.json", "transform": "plugin-manifest" },
        { "id": "rule", "source": "src/local/instructions", "destination": "plugins/agent-ecosystem/rules/portable-instructions.mdc", "transform": "cursor-rule" },
        { "id": "skills", "source": "src/local/skills", "destination": "plugins/agent-ecosystem/skills", "transform": "skill-name" },
        { "id": "agents", "source": "src/local/agents", "destination": "plugins/agent-ecosystem/agents", "transform": "copy" },
        { "id": "commands", "source": "src/local/commands", "destination": "plugins/agent-ecosystem/commands", "transform": "copy" },
        { "id": "templates", "source": "src/local/templates", "destination": "plugins/agent-ecosystem/templates", "transform": "copy" }
      ]
    }
  }
}
