{
  "id": "antigravity",
  "displayName": "Google Antigravity",
  "sharedConfig": true,
  "surfaces": ["app", "cli", "ide"],
  "pluginFormat": "antigravity-plugin",
  "scopes": {
    "global": {
      "root": { "homeRelative": [".gemini", "config"] },
      "components": [
        { "id": "plugin-manifest", "source": "adapters/antigravity/global/plugin.json", "destination": "plugins/agent-ecosystem/.antigravity-plugin/plugin.json", "transform": "plugin-manifest" },
        { "id": "rule", "source": "src/global/instructions", "destination": "plugins/agent-ecosystem/rules/portable-instructions.md", "transform": "antigravity-rule" },
        { "id": "skills", "source": "src/global/skills", "destination": "plugins/agent-ecosystem/skills", "transform": "copy" },
        { "id": "agents", "source": "src/global/agents", "destination": "plugins/agent-ecosystem/agents", "transform": "copy" },
        { "id": "commands", "source": "src/global/commands", "destination": "plugins/agent-ecosystem/commands", "transform": "copy" },
        { "id": "templates", "source": "src/global/templates", "destination": "plugins/agent-ecosystem/templates", "transform": "copy" }
      ]
    },
    "local": {
      "root": { "projectRelative": ".agents" },
      "components": [
        { "id": "plugin-manifest", "source": "adapters/antigravity/local/plugin.json", "destination": "plugins/agent-ecosystem/.antigravity-plugin/plugin.json", "transform": "plugin-manifest" },
        { "id": "rule", "source": "src/local/instructions", "destination": "plugins/agent-ecosystem/rules/portable-instructions.md", "transform": "antigravity-rule" },
        { "id": "skills", "source": "src/local/skills", "destination": "plugins/agent-ecosystem/skills", "transform": "copy" },
        { "id": "agents", "source": "src/local/agents", "destination": "plugins/agent-ecosystem/agents", "transform": "copy" },
        { "id": "commands", "source": "src/local/commands", "destination": "plugins/agent-ecosystem/commands", "transform": "copy" },
        { "id": "templates", "source": "src/local/templates", "destination": "plugins/agent-ecosystem/templates", "transform": "copy" }
      ]
    }
  }
}
